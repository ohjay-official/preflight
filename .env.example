# Code appended to any calldata this app sends. Required by lib/attribution.ts.
# This app sends no transactions today. Format: [a-z0-9_], 1 to 32 characters.
ATTRIBUTION_CODE=

# Celo mainnet read RPC.
CELO_RPC_URL=https://forno.celo.org

# Blockscout Celo API (the classic module=account API, not /api/v2).
BLOCKSCOUT_API_URL=https://celo.blockscout.com/api

# activity source: blockscout (default) or chainstack (not wired, see TODO in lib/activity/source.ts)
ACTIVITY_SOURCE=blockscout

# Adds the attribution-tag share check. Off by default. Does not change the pay verdict.
HACKATHON_MODE=false

# TODO: x402 gating at $0.02 per check is not implemented.
# true turns on a stub that returns HTTP 402 and collects nothing.
X402_GATING_ENABLED=false
