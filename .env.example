# Code appended to any calldata this app sends. Required by lib/attribution.ts.
# This app sends no transactions today. Format: [a-z0-9_], 1 to 32 characters.
ATTRIBUTION_CODE=

# Celo mainnet read RPC.
CELO_RPC_URL=https://forno.celo.org

# Blockscout Celo API (the classic module=account API, not /api/v2).
BLOCKSCOUT_API_URL=https://celo.blockscout.com/api

# activity source: blockscout (default) or chainstack (not wired, see TODO in lib/activity/source.ts)
ACTIVITY_SOURCE=blockscout

# Adds the attribution-tag share check. Off by default. Does not change the pay verdict.
HACKATHON_MODE=false

# TODO: x402 gating at $0.02 per check is not implemented.
# true turns on a stub that returns HTTP 402 and collects nothing.
X402_GATING_ENABLED=false

# ---- Preflight's own agent (Altana side; see docs/oh-jay-todo.md) ----

# Production host the owner's passkey is bound to, e.g. preflight-ohjay.vercel.app (no https://).
# Set it BEFORE the passkey is created; /setup refuses to run on any other host.
NEXT_PUBLIC_PASSKEY_RP_ID=

# Public site URL, used in receipts and the agent's ERC-8004 record, e.g. https://preflight-ohjay.vercel.app
NEXT_PUBLIC_SITE_URL=

# Set by the owner after the grant on /setup. ALTANA_SESSION is public JSON; ALTANA_SESSION_KEY is
# the capped session key and the only secret the agent has. No admin key or seed lives on the server.
ALTANA_SESSION=
ALTANA_SESSION_KEY=

# Paid check (/api/v1/check, $0.02 over x402). PAYTO_ADDRESS is the agent's Altana wallet.
# X402_API_KEY comes from x402.celo.org (connect a wallet, sign a message, no gas). Secret.
PAYTO_ADDRESS=
X402_API_KEY=
